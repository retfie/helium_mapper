#include <zephyr/dt-bindings/lora/sx126x.h>

/ {
	chosen {
		/delete-property/ zephyr,uart-mcumgr;
		/delete-property/ zephyr,bt-mon-uart;
		/delete-property/ zephyr,bt-c2h-uart;

		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,code-partition = &slot0_partition;
	};

	aliases {
		green-led = &led1;
		blue-led = &led2;
		//accel0 = &lis3dh;
		gps0 = &max7q;
		gnss = &gnss;
		lora0 = &lora;
	};

	vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc 7>;
		io-channel-names = "BATTERY";
		output-ohms = <510000>;
		full-ohms = <(1000000 + 510000)>;
		power-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
	};
};

&uicr {
	nfct-pins-as-gpios;
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_5";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>; // P0.31
		zephyr,resolution = <14>;
		zephyr,oversampling = <8>;
	};
};

&i2c0 {
	/delete-property/ zephyr,pm-device-runtime-auto;
	//status = "okay";
	status = "disabled";

	/* ST Microelectronics LIS3DH motion sensor */
/*
	lis3dh: lis3dh@18 {
		compatible = "st,lis3dh", "st,lis2dh";
		reg = <0x18>;
		irq-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		anym-on-int1;
	};
*/
};

&i2c1 {
	/* Cannot be used together with spi1. */
	status = "disabled";
};

&uart0 {
	compatible = "nordic,nrf-uarte";
	current-speed = <9600>;
	status = "okay";

	max7q: max7q {
		compatible = "u-blox,max7q";
		enable-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	gnss: u_blox_max7q {
		compatible = "u-blox,nmea-max7q";
		enable-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&spi2 {
	compatible = "nordic,nrf-spi";
	status = "okay";
	cs-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;

	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";
	lora: lora@0 {
		compatible = "semtech,sx1262";
		reg = <0>;
		reset-gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
		rx-enable-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
		dio1-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		dio3-tcxo-voltage = <SX126X_DIO3_TCXO_3V3>;
		tcxo-power-startup-delay-ms = <5>;
		spi-max-frequency = <1000000>;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/delete-node/ &reserved_partition_0;
/delete-node/ &code_partition;
/delete-node/ &storage_partition;
/delete-node/ &boot_partition;

&flash0 {
	partitions {
		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x00011000>;
		};
		slot0_partition: partition@10000 {
			label = "image-0";
			reg = <0x00011000 0x00071000>;
		};
		slot1_partition: partition@82000 {
			label = "image-1";
			reg = <0x00082000 0x00071000>;
		};
		storage_partition: partition@f8000 {
			label = "storage";
			reg = <0x000f8000 0x00008000>;
		};
	};
};
